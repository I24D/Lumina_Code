  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable the Lumina Cognitive OS layer."
      },
      "envPath": {
        "type": "string",
        "default": "c:/I24D_WhatsApp/.env",
        "description": "Absolute path to the .env file shared with the rest of I24D."
      },
      "memoryDir": {
        "type": "string",
        "description": "Directory where Working/Episodic memory JSONL files are stored. Defaults to %APPDATA%/lumina-cognitive-os."
      },
      "awarenessIntervalMs": {
        "type": "number",
        "default": 15000,
        "minimum": 2000,
        "maximum": 600000,
        "description": "Polling interval for the unified environment snapshot."
      },
      "wakeWordEnabled": {
        "type": "boolean",
        "default": false,
        "description": "Run the Python wake-word sidecar (requires Python with openwakeword installed)."
      },
      "wakeWordModel": {
        "type": "string",
        "default": "hey_jarvis_v0.1",
        "description": "Wake-word model name. Defaults to hey_jarvis_v0.1 (openwakeword bundled model)."
      },
      "bootGreetingEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Greet the user on startup with calendar/email/task context."
      },
      "browserDriverEnabled": {
        "type": "boolean",
        "default": false,
        "description": "Enable the Playwright/CDP browser driver tool. Disabled by default — opt-in."
      },
      "perceptionAutoStart": {
        "type": "boolean",
        "default": false,
        "description": "Auto-start the continuous semantic perception loop so Lumina always 'sees' the foreground app + its actionable UI elements. Opt-in (screen capture)."
      },
      "perceptionFps": {
        "type": "number",
        "default": 3,
        "description": "Capture rate for the perception loop (0.5-10). Higher = fresher sight, more CPU."
      },
      "skillsDir": {
        "type": "string",
        "default": "c:/I24D_WhatsApp/skills",
        "description": "Directory of agentskills.io skills Lumina can list/describe/run. Defaults to c:/I24D_WhatsApp/skills; LUMINA_SKILLS_DIR overrides."
      },
      "pcOperatorProvider": {
        "type": "string",
        "enum": ["auto", "gemini", "openai", "anthropic", "ollama"],
        "default": "auto",
        "description": "Default brain provider for lumina_pc_do. auto preserves fallback order; a tool call can still override it."
      },
      "pcOperatorModel": {
        "type": "string",
        "default": "",
        "description": "Optional default brain model for lumina_pc_do, for example gemma4:31b, gemini-2.5-flash, or a Claude/OpenAI model."
      },
      "supabaseSchema": {
        "type": "string",
        "default": "public",
        "description": "Supabase/PostgREST schema exposed to Lumina tools."
      },
      "supabaseMaxRows": {
        "type": "number",
        "default": 100,
        "minimum": 1,
        "maximum": 500,
        "description": "Maximum rows returned by lumina_supabase_query."
      },
      "supabaseAllowWrites": {
        "type": "boolean",
        "default": false,
        "description": "Enable lumina_supabase_mutate. Keep false unless the user explicitly wants database writes."
      },
      "warehousesPath": {
        "type": "string",
        "default": "c:/I24D_WhatsApp/src/cuerpo/warehouses",
        "description": "Path to Lumina's existing warehouses. Catalog only; OpenClaw does not load experimental cerebro/local AI modules."
      }
    }
  }
}

{
  "name": "@lumina/lumina-input-control",
  "version": "2026.7.2",
  "description": "Lumina input control — allowlisted mouse, keyboard, hotkey and window-focus control for the active Windows application. Opt-in and approval-gated.",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --target=node22 --external:openclaw/* --outfile=dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.3"
  },
  "devDependencies": {
    "esbuild": "*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.2",
      "minGatewayVersion": "2026.7.2"
    },
    "build": {
      "openclawVersion": "2026.7.2",
      "pluginSdkVersion": "2026.7.2"
    }
  }
}

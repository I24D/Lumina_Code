# Lumina Code model (Ollama Cloud). Kimi K3 is the primary supported model;
# GLM-5.2 remains the configured alternative.
OLLAMA_API_KEY=replace_with_your_ollama_cloud_key

# Start Talk voice, independent from the coding model. It ships configured for
# the OpenAI Realtime API (gpt-realtime-2.1, voice "marin"); set GEMINI_API_KEY
# instead to use Gemini Live. Configure only the provider you want. The OpenAI
# key also powers Start Talk's persistent memory embeddings (see below).
OPENAI_API_KEY=replace_with_your_openai_key
# GEMINI_API_KEY=replace_with_your_google_ai_studio_key

# Optional: private GitHub issues/pull requests and repository publishing.
I24D_GITHUB=replace_with_your_github_token

# Start Talk persistent memory (recall + auto-learning) over the Lumina brain
# in Supabase: long_term_memories, memory_wiki, knowledge_entries, user_profiles
# and conversations, with pgvector semantic search. Runs entirely in the
# extension host (core); the service_role key only ever travels to Supabase and
# never reaches the webview. Leave these unset to run voice without memory.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Optional overrides:
# START_TALK_WIKI_USER_ID=lumina
# START_TALK_MEMORY_SUMMARY_MODEL=gpt-4o-mini

# Optional Supabase memory replica (a separate, whole-snapshot mechanism for the
# sidebar). Uses a publishable key plus a signed-in user's access token. Never
# put a service_role/sb_secret key in a client-distributed configuration.
LUMINA_SUPABASE_URL=https://your-project.supabase.co
LUMINA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
LUMINA_SUPABASE_ACCESS_TOKEN=replace_with_authenticated_user_jwt
LUMINA_SUPABASE_MEMORY_TABLE=lumina_memory_state
LUMINA_SUPABASE_MEMORY_NAMESPACE=default
